# sdl pkg-config source file

prefix=/Volume2/backup/Software/Emulation/psc/PSC-CrossCompile-Toolchain/armv8-sony-linux-gnueabihf/armv8-sony-linux-gnueabihf/sysroot/usr
exec_prefix=${prefix}
libdir=${exec_prefix}/lib
includedir=${prefix}/include

Name: sdl2
Description: Simple DirectMedia Layer is a cross-platform multimedia library designed to provide low level access to audio, keyboard, mouse, joystick, 3D hardware via OpenGL, and 2D video framebuffer.
Version: 2.24.2
Requires:
Conflicts:
Libs: -L${libdir} -Wl,-rpath,${libdir} -Wl,--enable-new-dtags -lSDL2 
Libs.private:  -lm -liconv -ldl -lpthread -lrt
Cflags: -I${includedir} -I${includedir}/SDL2  -D_REENTRANT
